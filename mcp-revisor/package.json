{
  "name": "br-revisor-mcp",
  "version": "1.1.0",
  "description": "Servidor MCP con un único propósito: revisar contenido y falacias en textos de Battle Rol. Corre por stdio o en Cloudflare Workers.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "br-revisor": "src/server.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "build:worker": "node scripts/construir-worker.mjs",
    "test": "node --test",
    "dev:worker": "npx wrangler dev",
    "deploy:worker": "npx wrangler deploy"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "ISC",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "esbuild": "^0.28.2",
    "zod": "^4.6.7"
  }
}
